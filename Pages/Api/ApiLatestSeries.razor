@page "/api/latest-series"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Latest Series Machines (API)</PageTitle>

<div class="container-fluid mt-4">

    <p class="fw-bold">
        These machines are using the latest series of ALL their assets.
        Data retrieved via REST API.
    </p>

    <!-- API endpoint -->
    @if (!string.IsNullOrEmpty(apiEndpoint))
    {
        <div class="alert alert-secondary">
            <small>
                <strong>API Endpoint:</strong>
                <code>@apiEndpoint</code>
            </small>
        </div>
    }

    <!-- Loading -->
    @if (isLoading)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-success"></div>
            <p class="mt-2">
                Calling API to analyze machine configurations...
            </p>
        </div>
    }
    else if (machines.Any())
    {
        <!-- Results -->
        <h6 class="mt-3">
            <i class="bi bi-check-circle-fill"></i>
            Machines with Latest Series (@machines.Count)
        </h6>

        <div class="row mt-3">
            @foreach (var machine in machines)
            {
                <div class="col-md-2 mb-3">
                    <div class="card h-100">
                        <div class="card-body text-center">
                            <i class="bi bi-cpu" style="font-size: 3rem;"></i>
                            <h5 class="card-title">@machine</h5>
                            <span class="badge bg-success">
                                Fully Updated
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No machines are currently using the latest series of all their assets.
        </div>
    }

    <!-- Error -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-4">
            <i class="bi bi-x-circle"></i> @errorMessage
        </div>
    }

    <!-- Navigation -->
    <div class="mt-4">
        <a href="/" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
        <a href="/direct/latest-series"
           class="btn btn-outline-primary ms-2">
            <i class="bi bi-arrow-right"></i> Try Direct Version
        </a>
    </div>
</div>

@code {

    private List<string> machines = new();

    private bool isLoading = true;
    private string? errorMessage;
    private string? apiEndpoint;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var baseUrl = Navigation.BaseUri;

            apiEndpoint =
                $"GET {baseUrl}api/machines/latest-series";

            machines =
                await Http.GetFromJsonAsync<List<string>>(
                    $"{baseUrl}api/machines/latest-series")
                ?? new();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"API Error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
