@page "/"
@page "/all-machines"

@using KlingelnbergMachineManagement.Application.DTOs
@using KlingelnbergMachineManagement.Application.Services;

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>All Machine Details</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-0">All Machines</h4>
            <p class="text-muted mb-0">
                Total (@machines.Count) /
                Update needed (@machines.Count(m => !m.UsesLatestSeries)) /
                Latest (@machines.Count(m => m.UsesLatestSeries))
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary"
                    disabled="@isUploading"
                    @onclick="() => OpenUploadModal(ImportMode.Replace)">
                <i class="bi bi-upload me-1"></i> Upload New
            </button>

            <button class="btn btn-primary"
                    disabled="@isUploading"
                    @onclick="() => OpenUploadModal(ImportMode.Append)">
                <i class="bi bi-plus-circle me-1"></i> Add More
            </button>
        </div>
    </div>
    <!-- Success -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @successMessage
            <button class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Error -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle-fill me-2"></i>
            @errorMessage
            <button class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Page loading -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Loading machines...</p>
        </div>
    }
    else if (machines.Any())
    {
        @* <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0">All Machines</h4>
                <p class="text-muted mb-0">
                    Total (@machines.Count) /
                    Update needed (@machines.Count(m => !m.UsesLatestSeries)) /
                    Latest (@machines.Count(m => m.UsesLatestSeries))
                </p>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary"
                        disabled="@isUploading"
                        @onclick="() => OpenUploadModal(ImportMode.Replace)">
                    <i class="bi bi-upload me-1"></i> Upload New
                </button>

                <button class="btn btn-primary"
                        disabled="@isUploading"
                        @onclick="() => OpenUploadModal(ImportMode.Append)">
                    <i class="bi bi-plus-circle me-1"></i> Add More
                </button>
            </div>
        </div> *@

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Machine</th>
                        <th>Assets</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var machine in machines)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium">@machine.MachineType</div>
                                <small class="text-muted">
                                    @machine.Assets.Count assets
                                </small>
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var asset in machine.Assets)
                                    {
                                        <span>
                                            @asset.AssetName :
                                            <strong>@asset.SeriesNumber</strong>
                                            @if (!asset.IsLatestSeries)
                                            {
                                                <i class="bi bi-exclamation-circle text-warning ms-1"></i>
                                            }
                                        </span>
                                    }
                                </div>
                            </td>

                            <td class="pe-4">
                                @if (machine.UsesLatestSeries)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1">
                                        <i class="bi bi-check-circle me-1"></i> Latest
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-3 py-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Update Available
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cpu display-1 text-muted"></i>
            <h5 class="mt-3">No Machines Found</h5>
            <p class="text-muted">No machine data is available.</p>
        </div>
    }

    <!-- Upload Modal -->
    @if (ShowUploadModal)
    {
        <div class="modal fade show d-block"
             style="background: rgba(0,0,0,.5)">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            @(_currentImportMode == ImportMode.Replace
                                                    ? "Upload New Machine Data"
                                                    : "Add More Machine Data")
                    </h5>
                    <button class="btn-close"
                            disabled="@isUploading"
                            @onclick="CloseUploadModal"></button>
                </div>

                    <div class="modal-body">
                    @if (isUploading)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-2 mb-0">Uploading file…</p>
                            </div>
                        }
                        else
                        {
                            <InputFile OnChange="HandleFileUpload" />
                            <small class="text-muted d-block mt-2">
                                Supported formats: TXT / CSV / JSON
                            </small>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                disabled="@isUploading"
                                @onclick="CloseUploadModal">
                            Cancel
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@code {

    private List<MachineDetailDto> machines = new();

    private bool isLoading = true;
    private bool isUploading = false;
    private bool ShowUploadModal = false;

    private ImportMode _currentImportMode;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadMachinesAsync();
    }

    private async Task LoadMachinesAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var baseUrl = Navigation.BaseUri;

            machines =
                await Http.GetFromJsonAsync<List<MachineDetailDto>>($"{baseUrl}api/machines/details") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load machines: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenUploadModal(ImportMode mode)
    {
        _currentImportMode = mode;
        ShowUploadModal = true;
    }

    private void CloseUploadModal()
    {
        if (!isUploading)
            ShowUploadModal = false;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        errorMessage = null;
        successMessage = null;
        isUploading = true;

        try
        {
            var baseUrl = Navigation.BaseUri;

            var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(
                file.OpenReadStream(maxAllowedSize: 10_000_000));

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync(
                $"{baseUrl}api/machine-data/import?mode={_currentImportMode}",
                content);

            if (!response.IsSuccessStatusCode)
            {
                var serverMessage =
                    await response.Content.ReadAsStringAsync();

                errorMessage = string.IsNullOrWhiteSpace(serverMessage)
                    ? "Upload failed due to invalid data."
                    : serverMessage + " hiiii";

                return;
            }

            successMessage =
                _currentImportMode == ImportMode.Replace
                    ? "Data uploaded successfully. Existing data was replaced."
                    : "Data added successfully.";

            await LoadMachinesAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to reach server. Please try again.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            ShowUploadModal = false;
        }
    }
}
